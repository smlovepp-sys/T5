# ==================== EmbedUtils ====================
class EmbedUtils:
    def __init__(self, clip_model): self.clip = clip_model; self.device = next(clip_model.model.parameters()).device; self._cache = {}
    def get_embedding(self, text):
        if text not in self._cache:
            tokens = self.clip.tokenize([text]).to(self.device)
            with torch.no_grad(): out = self.clip.model(input_ids=tokens)
            self._cache[text] = out.last_hidden_state.mean(dim=1).squeeze(0)
        return self._cache[text]
    def similarity(self, t1, t2):
        e1 = self.get_embedding(t1); e2 = self.get_embedding(t2)
        return torch.cosine_similarity(e1.unsqueeze(0), e2.unsqueeze(0), dim=1).item()


# ==================== 动态阈值计算函数 ====================
def get_dynamic_thresholds(sim_sample_list, delta_sample_list,
                           low_quantile=0.3, mid_quantile=0.5, high_quantile=0.7):
    if len(sim_sample_list) < 5 or len(delta_sample_list) < 5:
        return {
            "mod_low": 0.25, "mod_mid": 0.30, "mod_high": 0.40,
            "verb_cut": 0.25, "noun_cut": 0.45,
            "delta_weak": 0.05, "delta_strong": 0.30,
            "diff_small": 0.05, "diff_mid": 0.08
        }

    sim_arr = np.array(sim_sample_list)
    mod_all = sim_arr[:, 0]
    verb_all = sim_arr[:, 1]
    noun_all = sim_arr[:, 2]
    delta_abs_arr = np.abs(np.array(delta_sample_list))

    th_mod_low = np.quantile(mod_all, low_quantile)
    th_mod_mid = np.quantile(mod_all, mid_quantile)
    th_mod_high = np.quantile(mod_all, high_quantile)

    th_verb_cut = np.quantile(verb_all, mid_quantile)
    th_noun_cut = np.quantile(noun_all, mid_quantile)

    th_delta_weak = np.quantile(delta_abs_arr, low_quantile)
    th_delta_strong = np.quantile(delta_abs_arr, high_quantile)

    diff_raw = np.abs(mod_all - verb_all)
    diff_median = np.median(diff_raw)
    th_diff_small = max(diff_median * 0.8, 0.03)
    th_diff_mid   = max(diff_median * 1.2, 0.06)

    return {
        "mod_low": th_mod_low,
        "mod_mid": th_mod_mid,
        "mod_high": th_mod_high,
        "verb_cut": th_verb_cut,
        "noun_cut": th_noun_cut,
        "delta_weak": th_delta_weak,
        "delta_strong": th_delta_strong,
        "diff_small": th_diff_small,
        "diff_mid": th_diff_mid
    }


