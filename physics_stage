    }

    # 地点/背景词，不作为核心物体，但可保留为环境或忽略
    LOCATION_WORDS = {"floor", "ground", "table", "hand", "wall", "bed", "chair", "room", "kitchen", "counter", "desk", "shelf", "door", "window", "street", "road", "ceiling"}

    TRIGGER_CONFIGS = {
        "撕裂类": {"bases": ["underwear", "dress", "fabric"], "param": "tear_intensity", "threshold": 0.08},
