# ==================== load_t5_clip ====================
def load_t5_clip(model_path: str = None):
    if model_path is None: model_path = "t5-small"
    tokenizer = T5TokenizerFast.from_pretrained(model_path)
    model = T5EncoderModel.from_pretrained(model_path).eval()
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model.to(device)

    class T5ClipWrapper:
        def __init__(self, m, t):
            self.model = m
            self.tokenizer = t
            self.shared = m.get_input_embeddings()
            self.device = device
        def tokenize(self, texts):
            if isinstance(texts, str): texts = [texts]
            return self.tokenizer(texts, return_tensors="pt", padding=True, truncation=True)["input_ids"]
        def encode_text(self, tokens, return_pooled=False):
            with torch.no_grad():
                tokens = tokens.to(self.device)
                outputs = self.model(input_ids=tokens)
            last_hidden = outputs.last_hidden_state
            if return_pooled: return last_hidden, last_hidden.mean(dim=1)
            return (last_hidden,)
    return T5ClipWrapper(model, tokenizer), tokenizer


